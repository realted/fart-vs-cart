{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ray tracer",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build and run CUDA SDL demo",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build-cuda-sdl.ps1",
        "-Run"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
